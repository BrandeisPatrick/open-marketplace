# Required for the AI assistants. Without it the app runs in "offline" mode:
# the UI, REST API and MCP server still work, and chat falls back to keyword commands.
ANTHROPIC_API_KEY=

# Server port (the Vite dev server proxies /api and /mcp here)
PORT=3001

# Claude model and effort for the chat assistants
MARKETPLACE_MODEL=claude-opus-5-5
MARKETPLACE_EFFORT=medium

# Set to 1 to enable server-side refusal fallbacks (beta) on chat requests
MARKETPLACE_FALLBACKS=0
